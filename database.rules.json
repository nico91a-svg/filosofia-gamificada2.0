{
  "rules": {
    ".read": false,
    ".write": false,

    "cursos_registro": {
      ".read": true,
      ".write": "auth != null && auth.token.role === 'docente'"
    },

    "students": {
      ".read": "auth != null && (auth.token.role === 'docente' || auth.token.cursoId === '3B-2026')",
      ".write": "auth != null && auth.token.role === 'docente'",
      "$studentId": {
        "artefactos": {
          ".write": "auth != null && (auth.token.role === 'docente' || auth.token.cursoId === '3B-2026')"
        },
        "vocabularioDescubierto": {
          ".write": "auth != null && (auth.token.role === 'docente' || auth.token.cursoId === '3B-2026')"
        }
      }
    },
    "activities": {
