          ".read": "auth != null && (auth.token.role === 'docente' || auth.token.cursoId === $cursoId)",
          ".write": "auth != null && auth.token.role === 'docente'"
        },
        "unidades": {
          ".read": "auth != null && (auth.token.role === 'docente' || auth.token.cursoId === $cursoId)",
          ".write": "auth != null && auth.token.role === 'docente'"
        },
        "position": {
          ".read": "auth != null && (auth.token.role === 'docente' || auth.token.cursoId === $cursoId)",
          ".write": "auth != null && auth.token.role === 'docente'"
        }
      }
    },

