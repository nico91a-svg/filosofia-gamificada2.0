{
  "name": "filosofo-en-formacion",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "publicar": "vite build --outDir ../app --emptyOutDir",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only database --project demo-filosofia-gamificada-rules-test --config ../firebase.json \"vitest run --config vitest.rules.config.js\"",
    "e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build",
    "hash-password": "node scripts/hash-password.mjs",
    "gestionar-cuentas": "node scripts/gestionar-cuentas.mjs",
    "build:app": "vite build --mode capacitor",
    "android:prepare": "npm run build:app && (test -d android || cap add android) && cap sync android && capacitor-assets generate --android",
    "android:apk": "npm run android:prepare && cd android && chmod +x gradlew && ./gradlew assembleDebug --no-daemon",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
